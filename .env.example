# Copy this file to .env and replace placeholders with local values.
DB_USER=replace-with-database-user
DB_PASSWORD=replace-with-database-password
MAPBOX_TOKEN=pk.replace-with-public-mapbox-token
JWT_SECRET_KEY=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:8080
FRONTEND_URL_PUBLIC=https://evacway.me
APP_URL_PUBLIC=https://evacway.me
APP_URL_LOCAL=http://localhost:8080
CLOUDFLARED_TUNNEL_TOKEN=replace-with-cloudflare-tunnel-token

# Frontend-only names for running Vite outside Docker.
VITE_MAPBOX_TOKEN=pk.replace-with-public-mapbox-token
VITE_API_URL=/api

# Optional backend mail and browser-push settings.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-sender
MAIL_PASSWORD=replace-with-mail-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=replace-with-sender
MAIL_FROM_NAME=EvacWay System
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com
PASSWORD_SETUP_TOKEN_MAX_AGE=3600
