# Copy to .env on the backend machine and fill in values there.
# Never commit the populated .env file or put these values in Vite/frontend config.
DATABASE_URL=postgresql://user:password@db:5432/evacway2
# Keep the per-process SQLAlchemy pool below the Supabase session pooler limit.
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=0
DATABASE_POOL_TIMEOUT=30
JWT_SECRET_KEY=replace-with-a-long-random-secret

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-sender@gmail.com
MAIL_PASSWORD=replace-with-a-new-gmail-app-password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your-sender@gmail.com
MAIL_FROM_NAME=EvacWay System
FRONTEND_URL_PUBLIC=https://evacway.vercel.app
FRONTEND_URL=https://evacway.vercel.app
APP_URL_PUBLIC=https://evacway.vercel.app
APP_URL_LOCAL=
PASSWORD_SETUP_TOKEN_MAX_AGE=3600
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_FAILURE_WINDOW_MINUTES=15
LOGIN_LOCK_MINUTES=15
LOGIN_RATE_LIMIT_MAX_REQUESTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900
LGU_TOTP_REQUIRED=false
DATA_PRIVACY_NOTICE_VERSION=1

# Optional browser push notifications for Admin/LGU dashboards.
# Generate private_key.pem and public_key.pem outside the repository with `vapid --gen`.
# Set VAPID_PRIVATE_KEY to the private PEM file path. Get VAPID_PUBLIC_KEY by
# running `vapid --private-key <private_key.pem> --applicationServerKey`.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIMS_SUB=mailto:admin@example.com

# Optional Supabase Storage for hazard/rescue photo uploads (falls back to shared DB table when unset).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=evacway-uploads
