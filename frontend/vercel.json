{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://evacway-2249.onrender.com/api/$1"
    },
    {
      "source": "/static/(.*)",
      "destination": "https://evacway-2249.onrender.com/static/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
